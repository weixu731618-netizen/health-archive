# 复制本文件为 backend/.env 并填入真实值（不要把真实值提交到 Git）。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- B2：iOS 推送（APNs）----------
# 总开关：false 时后端只保存 device token、不真正发推送（测试接口走 mock）。
# 拿到 Apple Developer 账号 + APNs Key 后改成 true，见 IOS_PUSH_SETUP.md。
PUSH_ENABLED=false
# APNs token-based 鉴权参数（.p8 密钥方式，不需要证书文件）
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.weixu.healthArchive
# .p8 私钥：二选一——直接贴内容，或给文件路径
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
# 开发用 TestFlight/真机调试填 true；App Store 正式版填 false
APNS_USE_SANDBOX=true
# 推送 token 存储（默认本地 SQLite，与云备份 DATABASE_URL 相互独立）
PUSH_DATABASE_URL=sqlite:///./push_dev.db
